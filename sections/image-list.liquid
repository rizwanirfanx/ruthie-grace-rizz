{%- liquid
  if section.blocks.size > 0
    assign first_block = section.blocks | first
  endif

  if section.settings.displayContent
    assign ratio_factor = 2
  else
   assign ratio_factor = 1
  endif
    
  assign classes = section.settings.style_class
  %}

{% style %}

   #section-{{ section.id }} .c-image-list__nav-wrapper {
   
    flex-direction: column;
    gap: 3rem;
}
{% unless section.settings.imageHeight == 'fill_screen' %}
  
  
    #section-{{ section.id }} .c-image-list__media  {
      {% if section.settings.imageHeight == 'adapt' %}
       --image-ratio-percent: {{ 1 | divided_by: first_block.settings.image.aspect_ratio | times: 100 }}%;
      {% elsif section.settings.imageHeight == 'square' %}
         --image-ratio-percent: 100%;
      {% elsif section.settings.imageHeight == 'portrait' %}
         --image-ratio-percent: 133%;
      {% else %}
         --image-ratio-percent: 62.5%;
      {% endif %}
    
        padding-bottom: calc( var(--image-ratio-percent) / {{ ratio_factor }} );
        height: 100%; 
      }


  {% else %}
    #section-{{ section.id }} .c-image-list__media  {
       padding-bottom: 0;
        height: 100vh; 
    }

  {%  endunless %}
.c-image-list__media {
  position:relative;
}
.c-image-list__media img {
  display: block;
    max-width: 100%;
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    object-fit:cover;
}
{% if section.settings.navHeadFont %}
#section-{{ section.id }} .c-image-list__nav {
font-family:var(--font-heading-family);
}


#section-{{ section.id }} .c-image-list__nav-wrapper  {
display:flex;
align-items:{{section.settings.nav_alignment_vertical}};
justify-content:{{section.settings.nav_alignment_horizontal}};
}


{% endif %}

{%- if section.settings.displayContent -%}
@media screen and (min-width:749px) {
#section-{{ section.id }} .c-image-list .c-image-list__media-item {
display:flex;
flex-direction:row;
}

#section-{{ section.id }} .c-image-list .c-image-list__media {
min-width:50%;
}

}

{%- endif -%}



#section-{{ section.id }} .c-image-list__nav-wrapper {
  min-width: {{section.settings.nav_width}}%;
}

#section-{{ section.id }} .c-image-list__media-wrapper {
  flex:1;
  
}

@media screen and (min-width:750px) {
#section-{{ section.id }} .c-image-list__media-content {
display:flex;
flex-direction:column;
justify-content:{{section.settings.content_alignment_vertical}};
}

}




{{ section.settings.custom_css }}


{% endstyle %}


<div class="{% unless section.settings.fullWidth %}page-width{% endunless %} {{ classes }}" id="section-{{ section.id }}">
  <div class="js-image-list c-image-list" data-activate-items-on-hover="{{section.settings.activateItemsOnHover}}" style="{% if section.settings.bgColor != blank %}background-color:{{ section.settings.bgColor }};{% endif %}">

    <div class="c-image-list__nav-wrapper c-image-list__nav-wrapper--position-{{ section.settings.navLinksPosition }}">
      <ul class="c-image-list__nav c-image-list__nav--alignment-{{ section.settings.navLinksAlignment }} {%- if section.settings.navLinksActiveBottomBorder -%}c-image-list__nav--active-border{%- endif -%}" style="{% if section.settings.navLinksPadding != blank %} padding:{{ section.settings.navLinksPadding }}vw;{% endif %}">
        {% for block in section.blocks %}
          <li style="{% if section.settings.navLinksActiveStateColor != blank %} color:{{ section.settings.navLinksActiveStateColor }};{% endif %}">
            <a class="{% if forloop.index == 1 %}is-active{% endif %}" href="{{ block.settings.buttonLink }}" data-index="{{ forloop.index0 }}" style="padding-top: {{ section.settings.spaceBetweenNavigationLinks }}rem; padding-bottom: {{ section.settings.spaceBetweenNavigationLinks }}rem; {% if section.settings.navLinksColor != blank %} color:{{ section.settings.navLinksColor }};{% endif %}{% if section.settings.navLinksFontSize != blank %} font-size:clamp(2rem,{{ section.settings.navLinksFontSize }}vw,12rem);{% endif %}{% if section.settings.navLinksLineHeight != blank %} line-height:{{ section.settings.navLinksLineHeight }};{% endif %}">
              <span>{{ block.settings.title }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>

      <div class="section-button-container">
                <a class="button  button--primary"{% if section.settings.buttonLink == blank %} role="link" aria-disabled="true"{% else %} href="{{ section.settings.buttonLink }}"{% endif %}>
                  {% if section.settings.buttonLabel != blank %}
                    {{ section.settings.buttonLabel | escape }}
                  {% else %}
                    {{ section.settings.buttonLabel | escape }}
                  {% endif %}
                </a>
      </div>
     
    </div>

    <div class="c-image-list__media-wrapper">

    {% for block in section.blocks %}

    <div class="c-image-list__media-item{% if forloop.index == 1 %} is-active{% endif %}" {{ block.shopify_attributes }}>

         
          {%- if block.settings.image != blank -%}
            <div class="c-image-list__media">
              {{ block.settings.image | image_url: width: 3840 | image_tag:
                sizes: "(min-width: 750px) 50vw, 100vw",
                widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                class: 'c-image-list-image'
            }}
            </div>
          {%- endif -%}
      

          <!-- Content Block -->
          {%- if section.settings.displayContent -%}
          <div class="c-image-list__media-content" style="{% if section.settings.textColor != blank %} color:{{ section.settings.textColor }};{% endif %}{% if section.settings.contentPadding %}padding: {{ section.settings.contentPadding }}rem;{% endif %}">
            <h2 class="{{ block.settings.heading_size }}" style="{% if section.settings.titleColor != blank %} color:{{ section.settings.titleColor }};{% endif %}">{{ block.settings.title }}</h2>
            {{ block.settings.text }}

            {%- if section.settings.displayButton -%}
              <div class="c-image-list__button-container">
                <a class="button{% if section.settings.buttonStyleSecondary1 %} button--secondary{% else %} button--primary{% endif %}"{% if block.settings.buttonLink == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.buttonLink }}"{% endif %}>
                  {% if block.settings.buttonLabel != blank %}
                    {{ block.settings.buttonLabel | escape }}
                  {% else %}
                    {{ section.settings.buttonLabel | escape }}
                  {% endif %}
                </a>
              </div>
            {%- endif-%}

          </div>
          {%- endif-%}
          <!-- end Content Block -->


      </div>
      {% endfor %}

    </div>
  </div>
</div>

